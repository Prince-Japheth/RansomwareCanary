# --- Python Artifacts ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual Environment (NEVER PUSH THIS) ---
venv/
env/
.env

# --- Runtime Data (Logs & Bait) ---
logs/
*.log
_BAIT_FILE.txt
backup_keys.txt
wallet_backup.dat
recovery_codes.txt
master_key.txt
_backup_codes.txt

# --- Distribution & Build Files ---
*.zip
build/
release_*/

# --- Dist folder (binaries) - Ignored by default, but can be force-added if needed
# NOTE: For academic submission, binaries are force-added using: git add -f dist/
# This is a "student hack" to ensure lecturers can easily find the executables.
# In production, binaries should be in GitHub Releases, not the main repo.
# To add specific binaries: git add -f dist/RansomwareCanary.exe
dist/
!dist/.gitkeep

# --- Spec files (auto-generated, but useful for rebuilding)
*.spec

# --- OS Junk ---
.DS_Store
Thumbs.db

# --- IDE Files ---
.vscode/
.idea/
*.swp
*.swo
*~

